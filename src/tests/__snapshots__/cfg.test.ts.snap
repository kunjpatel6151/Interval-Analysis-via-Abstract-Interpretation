// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Control Flow Graph (CFG) Construction > generates consistent Graphviz DOT output for while example 1`] = `
"digraph CFG {
  rankdir=TB;
  node [fontname="Courier", fontsize=11, shape=circle];
  edge [fontname="Courier", fontsize=10];

  0 [label="N0\\n(entry)"];
  1 [label="N1"];
  2 [shape=doublecircle, color=blue, penwidth=2, label="N2\\n[loop head]"];
  3 [label="N3"];
  4 [label="N4"];
  5 [label="N5\\n(exit)"];

  0 -> 1 [label="int i = 0 (L1)"];
  1 -> 2 [label="skip (L1)"];
  2 -> 3 [label="[i < 100] (L1)"];
  3 -> 4 [label="i = i + 1 (L1)"];
  4 -> 2 [label="skip (L1)"];
  2 -> 5 [label="[!(i < 100)] (L1)"];
}"
`;
